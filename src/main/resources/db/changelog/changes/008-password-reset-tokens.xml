<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Password reset tokens.
        Only the SHA-256 hash of the raw token is stored — prevents reset link
        reuse if the DB is breached. The raw token is sent via email and never saved.
        Tokens expire after 15 minutes and are marked used on consumption.
    -->
    <changeSet id="008-create-password-reset-tokens" author="unisphere">
        <createTable tableName="password_reset_tokens">
            <column name="id" type="BIGINT UNSIGNED" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- SHA-256 hex hash of the raw token sent to the user -->
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_prt_token_hash"/>
            </column>
            <column name="user_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="used" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_prt_user"
                baseTableName="password_reset_tokens" baseColumnNames="user_id"
                referencedTableName="users"            referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="password_reset_tokens" indexName="idx_prt_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="password_reset_tokens" indexName="idx_prt_expires_at">
            <column name="expires_at"/>
        </createIndex>
        <!-- Explicit rollback: MySQL refuses to drop an index that backs a foreign
             key, so the auto-generated reverse (drop indexes, then table) fails.
             Dropping the table removes its indexes and constraints together. -->
        <rollback>
            <dropTable tableName="password_reset_tokens"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
